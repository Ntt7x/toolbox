{
  "name": "@toolbox/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:integration": "tsx --test --test-concurrency=1 \"test-integration/*.integration.test.ts\""
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@hono/node-server": "^1",
    "@toolbox/shared": "workspace:*",
    "cron-parser": "^5.10.0",
    "hono": "^4",
    "playwright-core": "^1.62.1",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5"
  }
}
